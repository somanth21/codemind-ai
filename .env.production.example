# ==============================================================================
# CodeMind AI - Production Environment Configuration Template
# Copy this file to .env.production on your production server.
# NEVER commit real credentials, production secrets, or private keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16+ or Managed Neon / Supabase / RDS)
# ------------------------------------------------------------------------------
# If using a managed database connection string (e.g., Neon, Render, Railway, AWS RDS):
USE_ENV_DATABASE_URL=true
DATABASE_URL=postgresql://neondb_owner:npg_your_password@ep-your-instance.aws.neon.tech/neondb?sslmode=require

# Alternatively, if using discrete host and port variables:
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=codemind_db
# DB_USER=codemind_user
# DB_PASSWORD=your_super_secure_db_password_here

# Connection pool sizing
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure 256-bit key using: openssl rand -base64 32
JWT_SECRET=replace_with_a_cryptographically_secure_256_bit_base64_secret_key_here
JWT_EXPIRATION_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days

# Initial Administrator Provisioning (Created automatically on first boot if absent)
CODEMIND_ADMIN_EMAIL=admin@codemind.ai
CODEMIND_ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Allowed CORS Origins (Comma-separated, no trailing slash)
# Include your production domain and local dev origins if needed
CORS_ALLOWED_ORIGINS=https://codemind.yourdomain.com,http://localhost,http://localhost:80

# ------------------------------------------------------------------------------
# 3. Grounded AI & LLM Engine (Google Gemini / OpenAI / Claude)
# ------------------------------------------------------------------------------
LLM_PROVIDER=GEMINI
CODEMIND_LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=20
LLM_RATE_LIMIT_USER=10
LLM_RATE_LIMIT_REPO=20

# ------------------------------------------------------------------------------
# 4. Repository Sandbox & AST Engine Limits
# ------------------------------------------------------------------------------
CODEMIND_SANDBOX_ROOT=/app/codemind-sandbox
CODEMIND_MAX_ARCHIVE_SIZE=104857600   # 100 MB max ZIP upload
CODEMIND_MAX_EXTRACTED_SIZE=524288000 # 500 MB max uncompressed
CODEMIND_MAX_FILE_COUNT=20000
CODEMIND_MAX_SINGLE_FILE_SIZE=104857600

# ------------------------------------------------------------------------------
# 5. Network & Port Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080
PORT=80
SPRING_PROFILES_ACTIVE=prod
