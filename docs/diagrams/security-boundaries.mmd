graph TB
    subgraph ClientBoundary ["TRUST BOUNDARY: Client Tier"]
        User["User / Client"]
        BrowserApp["Frontend SPA (React 18 / Vite)<br/>• Memory-only token state<br/>• Content Security Policy<br/>• Zero raw secret rendering"]
        User -->|"TLS / HTTPS"| BrowserApp
    end

    subgraph AppBoundary ["TRUST BOUNDARY: Trusted Application Logic (Backend Monolith)"]
        SecGateway["Spring Security Gateway<br/>• Stateless JWT Validation (HMAC-SHA256 &ge; 256-bit)<br/>• Role-Based Access Control (ADMIN, DEVELOPER, AUDITOR)<br/>• Multi-Tenant IDOR Guard (repo.owner.id == user.id)<br/>• MDC Correlation ID Tracking"]
        
        BrowserApp -->|"REST Requests + Bearer Token"| SecGateway

        subgraph IngestionControls ["Ingestion Defense Layer"]
            TraversalGuard["PathTraversalGuard<br/>• Normalized path verification<br/>• Reject '../', '..\\', Windows drive prefixes<br/>• Prohibit symlinks & device files"]
            ZipGuard["Resource Exhaustion Guard<br/>• Max archive size: 100MB<br/>• Max uncompressed: 500MB<br/>• Max file count: 20,000<br/>• Atomic rollback on breach"]
        end

        subgraph AnalysisControls ["Deterministic Analysis Controls"]
            NonExecutionInvariant["Non-Execution Invariant<br/>• NO javac / compiler invocation<br/>• NO shell script execution (make, bash, cmd)<br/>• NO dynamic classloading<br/>• Pure static AST traversal"]
            SecretRedactor["Secret Redactor<br/>• High-confidence credential scanner<br/>• Masking: 4-char prefix + 2-char suffix<br/>• Zero plaintext in DB / Logs / Prompts"]
        end

        subgraph AIControls ["AI Safety & Grounding Controls"]
            RateLimiter["Sliding-Window Rate Limiter<br/>• Per-user and per-repository quotas"]
            InjectionDefense["Prompt Injection Defense<br/>• Neutralize delimiter tags<br/>• Enclose evidence in &lt;BEGIN_REPOSITORY_EVIDENCE&gt;<br/>• Treat repository content as untrusted input"]
            ContextBudget["Context Budget Manager<br/>• Hard caps: 10 chunks, 16k chars, 4k tokens<br/>• Prioritize top-K deterministic evidence"]
            GroundingValidator["Grounding & Security Gate Validator<br/>• Assert cited [E#] IDs exist in context<br/>• BLOCKED candidates cannot be recommended"]
        end

        AuditLogger["Security Audit Service<br/>• Log LOGIN, INGESTION, ANALYSIS, AI_REASONING<br/>• Automatic redaction of sensitive parameters"]

        SecGateway --> IngestionControls
        SecGateway --> AnalysisControls
        SecGateway --> AIControls
        SecGateway --> AuditLogger
    end

    subgraph SandboxBoundary ["TRUST BOUNDARY: Untrusted Repository Data (Filesystem Sandbox)"]
        SandboxStorage[("Isolated Filesystem Sandbox<br/>• Physical isolation per repository UUID<br/>• Read-only access after extraction<br/>• STRICTLY UNTRUSTED INPUT")]
        IngestionControls -->|"Atomic Unpack (No Execution)"| SandboxStorage
        AnalysisControls -->|"Read-Only AST Parsing"| SandboxStorage
    end

    subgraph DatabaseBoundary ["TRUST BOUNDARY: Persistence Tier"]
        Database[("PostgreSQL 16 + pgvector<br/>• Foreign key tenant isolation<br/>• Parameterized SQL queries (No injection)<br/>• Masked secret storage only<br/>• Append-only security audit log")]
        SecGateway --> Database
        AnalysisControls --> Database
        AuditLogger --> Database
    end

    subgraph ExternalAIBoundary ["TRUST BOUNDARY: External AI Service"]
        LLM["Google Gemini API<br/>• Zero repository execution rights<br/>• Receives only minimal sanitized evidence<br/>• Downstream explanatory role only (NOT authoritative)"]
        AIControls -->|"Sanitized Context via HTTPS"| LLM
        LLM -->|"Probabilistic Response (Inspected)"| AIControls
    end

    %% Styles
    classDef clientStyle fill:#eff6ff,stroke:#3b82f6,stroke-width:2px;
    classDef appStyle fill:#f0fdf4,stroke:#22c55e,stroke-width:2px;
    classDef untrustedStyle fill:#fef2f2,stroke:#ef4444,stroke-width:2px,stroke-dasharray: 5 5;
    classDef dbStyle fill:#f8fafc,stroke:#64748b,stroke-width:2px;
    classDef aiStyle fill:#faf5ff,stroke:#a855f7,stroke-width:2px;

    class ClientBoundary clientStyle;
    class AppBoundary appStyle;
    class SandboxBoundary untrustedStyle;
    class DatabaseBoundary dbStyle;
    class ExternalAIBoundary aiStyle;
