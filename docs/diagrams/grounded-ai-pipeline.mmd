flowchart TD
    UserQuery["User Request / Engineering Query"] --> RetEngine["Deterministic Repository Retrieval"]
    
    subgraph EvidenceSources ["Authoritative Deterministic Evidence Sources (SOURCE OF TRUTH)"]
        E1["Deterministic Reuse Analysis<br/>(Decisions, scores, candidates, lines)"]
        E2["Deterministic Security Findings<br/>(CWE IDs, rule matches, masked code snippets)"]
        E3["Deterministic Architecture Intelligence<br/>(Coupling metrics, cycles, hotspots, smells)"]
        E4["Deterministic Symbol Table & AST<br/>(Signatures, hierarchy, callers, callees)"]
    end

    RetEngine --> EvidenceSources

    subgraph GroundingPipeline ["Grounded Evidence Packaging (Pre-LLM Guard)"]
        EvidenceSources --> Selector["EvidenceSelectionService<br/>• Select top-K relevant evidence items<br/>• Assign deterministic citation IDs: [E1], [E2], ..."]
        
        Selector --> Sanitizer["Prompt Injection Defense & Redaction<br/>• Neutralize delimiter tags: &lt;SYSTEM&gt;, &lt;BEGIN_...&gt;<br/>• Deterministic high-entropy secret masking"]
        
        Sanitizer --> BudgetManager["ContextBudgetManager<br/>• Enforce hard budget caps (max 10 chunks, 16k chars, 4k tokens)<br/>• Flag context truncation if budget exceeded"]
    end

    subgraph LLMInvocation ["Constrained Downstream Reasoning Tier"]
        BudgetManager --> PromptAssembler["GroundedPromptBuilder<br/>• Immutable System Prompt (UNTRUSTED DATA boundary)<br/>• Enclose chunks inside &lt;BEGIN_REPOSITORY_EVIDENCE&gt;<br/>• Enforce JSON schema contract with evidence references"]
        
        PromptAssembler --> LLM["External LLM Provider (Google Gemini)<br/>NOT THE SOURCE OF TRUTH<br/>(Downstream explanatory interpreter only)"]
    end

    subgraph PostValidation ["Validation & Invariant Verification Tier"]
        LLM --> Parser["StructuredResponseParser<br/>• Strip markdown code fences<br/>• Parse & validate JSON structure"]
        
        Parser --> GroundingValidator["GroundingValidator & Security Gate Checker<br/>• Verify all cited [E#] IDs exist in context<br/>• Compute citation coverage ratio<br/>• Detect fabricated / hallucinated evidence IDs<br/>• Assert Security Gate Invariant: BLOCKED &ne; direct reuse"]
    end

    GroundingValidator --> VerifiedOutput["Final Grounded Explanation Response<br/>• Summary & Recommendation<br/>• Reasoning claims cited with [E1], [E2]<br/>• Identified limitations & trade-offs<br/>• Provenance telemetry (tokens, latency, provider)"]

    subgraph LimitationNote ["Explicit System Boundary & Known Limitation"]
        Limitation["LIMITATION NOTE:<br/>Citation validation deterministically verifies that cited evidence IDs [E#]<br/>were genuinely provided in the context prompt and that citations exist.<br/>It does NOT mathematically prove that every natural-language assertion<br/>generated by the LLM is semantically or factually correct."]
    end

    VerifiedOutput -.-> Limitation

