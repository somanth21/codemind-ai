# ==============================================================================
# CodeMind AI - Local Development Environment Template
# Copy this file to .env for local running.
# ==============================================================================

# Server Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL 16 or Neon PostgreSQL)
# If using Neon / Supabase cloud connection string:
USE_ENV_DATABASE_URL=true
DATABASE_URL=postgresql://neondb_owner:npg_5lDb4TektnFx@ep-polished-scene-azydfq2y-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Alternatively, for local Docker Postgres:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codemind_db
DB_USER=codemind_user
DB_PASSWORD=codemind_dev_pass

# Security & JWT Configuration
JWT_SECRET=c3VwZXJfc2VjcmV0X2tleV9mb3JfZGV2ZWxvcG1lbnRfb25seV9kb19ub3RfdXNlX2luX3Byb2RfdW5sZXNzX292ZXJyaWRkZW5fYnlfZW52
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://localhost:80

# Grounded AI & LLM Engine
LLM_PROVIDER=GEMINI
CODEMIND_LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=20

# Initial Admin Credentials
CODEMIND_ADMIN_EMAIL=admin@codemind.ai
CODEMIND_ADMIN_PASSWORD=AdminSecure123!

# Repository Sandbox
CODEMIND_SANDBOX_ROOT=./codemind-sandbox
CODEMIND_MAX_ARCHIVE_SIZE=104857600
CODEMIND_MAX_EXTRACTED_SIZE=524288000
CODEMIND_MAX_FILE_COUNT=20000
CODEMIND_MAX_SINGLE_FILE_SIZE=104857600
