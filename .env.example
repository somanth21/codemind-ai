# ==============================================================================
# CodeMind AI - Environment Configuration Template
# COPY this file to .env for local deployment.
# NEVER commit real credentials, production secrets, or API keys to source control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL 16 + pgvector)
# Note: In 'dev' profile without PostgreSQL running, fallback profile 'test' uses embedded H2.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codemind_db
DB_USER=codemind_user
DB_PASSWORD=your_secure_database_password_here

# Security & JWT Configuration
# Requirement: Minimum 256-bit (32 bytes) secret key for HMAC-SHA256
JWT_SECRET=your_base64_encoded_or_sufficiently_long_jwt_secret_key_change_me_in_production_min_32_bytes
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Repository Sandbox Configuration (Phase 2)
CODEMIND_SANDBOX_ROOT=./codemind-sandbox
CODEMIND_MAX_ARCHIVE_SIZE=104857600
CODEMIND_MAX_EXTRACTED_SIZE=524288000
CODEMIND_MAX_FILE_COUNT=20000
CODEMIND_MAX_SINGLE_FILE_SIZE=104857600

# CORS Allowed Origins (Comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider Configuration (Pluggable SPI: GEMINI | OPENAI | CLAUDE | OLLAMA)
# For Phase 1 Foundation, LLM calls are disabled/mocked.
LLM_PROVIDER=GEMINI
LLM_API_KEY=your_llm_api_key_placeholder_here
LLM_MODEL=gemini-1.5-pro

# Observability & Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
